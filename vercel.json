{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/task-board",
      "dest": "/jira_task_board.html"
    },
    {
      "src": "/backlog",
      "dest": "/backlog.html"
    },
    {
      "src": "/active-sprint",
      "dest": "/active_sprint.html"
    },
    {
      "src": "/reports",
      "dest": "/reports.html"
    },
    {
      "src": "/settings",
      "dest": "/settings.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
